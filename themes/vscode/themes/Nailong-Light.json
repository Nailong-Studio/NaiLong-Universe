  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8FA99A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string punctuation"
      ],
      "settings": {
        "foreground": "#8D6E00"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#00838F"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F57F17"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#C62828"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#0277BD"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#F9A825"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#0E1510"
      }
    },
    {
      "scope": [
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#6A1B9A"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#C62828"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F57F17"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#8FA99A"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#F9A825",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#0277BD",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#EF5350",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#0E1510",
    "variable.readonly": "#6A1B9A",
    "parameter": "#F57F17",
    "function": "#0277BD",
    "class": "#F9A825",
    "keyword": "#C62828",
    "string": "#8D6E00",
    "number": "#6A1B9A",
    "comment": "#8FA99A"
  }
}