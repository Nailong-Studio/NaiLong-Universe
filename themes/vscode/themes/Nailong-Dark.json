  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9C8E7A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string punctuation",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#FFD54F"
      }
    },
    {
      "scope": [
        "string.regexp",
        "string.regexp punctuation"
      ],
      "settings": {
        "foreground": "#80DEEA"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#FFD54F"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#E57373"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#4FC3F7"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#FFE082"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E8F5E9"
      }
    },
    {
      "scope": [
        "variable.other.readwrite",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#CE93D8"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#E57373"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFD54F"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#8A7A5A"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#FFD54F",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#E8F5E9"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#E8F5E9"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#4FC3F7",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EF9A9A",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#4FC3F7"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#FFD54F"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E57373"
      }
    },
    {
      "scope": [
        "support.constant.property-value",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#FFCC80"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#E8F5E9",
    "variable.readonly": "#CE93D8",
    "parameter": "#FFE082",
    "function": "#4FC3F7",
    "method": "#4FC3F7",
    "class": "#FFE082",
    "interface": "#80DEEA",
    "enum": "#FFD54F",
    "type": "#FFD54F",
    "namespace": "#FFD54F",
    "keyword": "#E57373",
    "string": "#FFD54F",
    "number": "#CE93D8",
    "regexp": "#80DEEA",
    "comment": "#9C8E7A",
    "macro": "#BA68C8",
    "property": "#4DD0E1",
    "operator": "#E57373"
  }
}