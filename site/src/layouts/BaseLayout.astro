---
import "../styles/global.css"
import { ClientRouter } from "astro:transitions"
import SiteNav from "../components/SiteNav.astro"
import SiteFooter from "../components/SiteFooter.astro"
import Lightbox from "../components/Lightbox.astro"
import { url } from "../lib/url"
// 字体 ?url 导入：构建后得到带 hash 的同域资源地址，用于 preload（与 fontsource CSS 内引用同一文件）
import frauncesWoff from "@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url"
import groteskWoff from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url"

export interface Props {
  title: string
  description: string
  /** 社交分享图（绝对或站内路径） */
  image?: string
  type?: "website" | "article"
  noindex?: boolean
  /** 页面级额外 JSON-LD */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const {
  title,
  description,
  image = "thumbs/fullhd/nailong-01.webp",
  type = "website",
  noindex = false,
  jsonLd,
} = Astro.props

const site = Astro.site ?? new URL("https://nailong-studio.github.io")
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "/"), site).href
const ogImage = image.startsWith("http") ? image : new URL(url(image), site).href
const fullTitle = title.includes("奶龙") ? title : `${title} · 奶龙艺术宇宙`

const baseLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "奶龙艺术宇宙",
  alternateName: "Nailong Art Universe",
  url: site.href,
  inLanguage: "zh-CN",
  potentialAction: {
    "@type": "SearchAction",
    target: `${new URL(url("/gallery/"), site).href}?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
}
const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
---

<!doctype html>
<html lang="zh-CN" data-theme="dark" data-focus="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbf9f4" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="奶龙艺术宇宙" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" hreflang="zh-CN" href={canonical} />
    <link rel="sitemap" href={url("sitemap-index.xml")} />

    {/* 首屏关键字体 preload（同域自托管，非第三方字体服务；?url 导入已含 base 前缀） */}
    <link rel="preload" as="font" type="font/woff2" href={frauncesWoff} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={groteskWoff} crossorigin />

    {/* 跨页面 View Transitions：画廊封面与详情主图共享元素过渡 */}
    <ClientRouter />

    <script
      is:inline
      set:html={`(function(){try{var d=document.documentElement;d.classList.add('js');var t=localStorage.getItem('nl:theme');if(t)d.dataset.theme=t;var f=localStorage.getItem('nl:focus');if(f==='on')d.dataset.focus='on';setTimeout(function(){var n=document.querySelectorAll('[data-reveal]:not([data-revealed])');for(var i=0;i<n.length;i++)n[i].setAttribute('data-revealed','true');},2500);}catch(e){}})();`}
    />
    <noscript><style>[data-reveal]{opacity:1 !important;transform:none !important}</style></noscript>
    <script type="application/ld+json" set:html={JSON.stringify(baseLd)} />
    {extraLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>

  <body class="has-noise">
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div class="progress" aria-hidden="true"></div>

    <SiteNav />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />

    <Lightbox />

    <div class="cursor-glow" aria-hidden="true"></div>

    <script>
      import "../scripts/site"
    </script>
  </body>
</html>
