---
import type { GetStaticPaths } from "astro"
import BaseLayout from "../../../layouts/BaseLayout.astro"
import ArtCard from "../../../components/ArtCard.astro"
import { artworks, byCategory, humanSize, neighbors, themeOf } from "../../../lib/artworks"
import { url } from "../../../lib/url"

export const getStaticPaths = (() =>
  artworks.map((item) => ({
    params: { category: item.category, slug: decodeURIComponent(item.slug) },
    props: { item },
  }))) satisfies GetStaticPaths

const { item } = Astro.props
const theme = themeOf(item.category)
const { prev, next } = neighbors(item)
const related = byCategory(item.category)
  .filter((a) => a.id !== item.id)
  .slice(0, 6)

// 与 ArtCard 一致的跨页共享元素名（封面卡片 → 详情主图无缝放大）
const vtName = `art-${item.category}-${item.slug.replace(/[^\p{L}\p{N}_-]/gu, "-")}`

const displayTitle = item.variant ? `${item.title} · ${item.variant}` : item.title
const ld = {
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  name: displayTitle,
  description: item.story,
  artform: "Digital Art",
  genre: theme.name,
  image: item.view,
  contentUrl: item.view,
  width: { "@type": "QuantitativeValue", value: item.w, unitCode: "E37" },
  height: { "@type": "QuantitativeValue", value: item.h, unitCode: "E37" },
  isPartOf: { "@type": "ImageGallery", name: `奶龙艺术宇宙 · ${theme.name}` },
  keywords: item.tags.join(", "),
}
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首页", item: new URL(url("/"), Astro.site!).href },
    { "@type": "ListItem", position: 2, name: theme.name, item: new URL(url(`/gallery/${theme.slug}/`), Astro.site!).href },
    { "@type": "ListItem", position: 3, name: displayTitle, item: Astro.url.href },
  ],
}
---

<BaseLayout
  title={`${displayTitle} · ${theme.name}`}
  description={item.story}
  image={item.thumb}
  type="article"
  jsonLd={[ld, crumbs]}
>
  <article class="wrap section">
    <nav aria-label="面包屑" class="eyebrow" style="margin-bottom:var(--s-5);display:flex;gap:var(--s-2);flex-wrap:wrap">
      <a href={url("/")}>首页</a><span aria-hidden="true">/</span>
      <a href={url(`/gallery/${theme.slug}/`)}>{theme.name}</a><span aria-hidden="true">/</span>
      <span aria-current="page" style="color:var(--c-text-dim)">{displayTitle}</span>
    </nav>

    <div class="detail">
      <div>
        <a
          class="detail__stage"
          href={item.view}
          data-lb-solo
          data-lb
          data-lb-full={item.view}
          data-lb-srcset={item.fullSrcset}
          data-lb-title={displayTitle}
          data-lb-href={item.view}
          data-lb-w={item.w}
          data-lb-h={item.h}
          style={`--tint:${item.dominant};--lqip:url("${item.lqip}")`}
          aria-label="点击放大原图"
        >
          <img
            src={item.view}
            srcset={item.fullSrcset}
            sizes="(min-width: 1000px) 66vw, 100vw"
            width={item.w}
            height={item.h}
            alt={`${displayTitle} —— ${theme.name}展品`}
            decoding="async"
            fetchpriority="high"
            data-fade
            transition:name={vtName}
          />
        </a>
        <p class="eyebrow" style="margin-top:var(--s-3)">点击图片进入全屏预览 · 大图按屏幕宽度实时转码</p>
      </div>

      <div class="detail__meta">
        <p class="eyebrow">{theme.en}</p>
        <h1 style="font-size:var(--fs-2xl);margin:var(--s-2) 0 var(--s-3)">{item.title}</h1>
        {item.variant && <p class="eyebrow" style="margin-bottom:var(--s-4)">版本 {item.variant}</p>}
        <p style="color:var(--c-text-dim)">{item.story}</p>

        {item.tags.length > 0 && (
          <div class="tagrow">
            {item.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )}

        <dl class="meta-list">
          <div><dt>展厅</dt><dd>{theme.name}</dd></div>
          <div><dt>原始尺寸</dt><dd>{item.w} × {item.h}</dd></div>
          <div><dt>原始文件大小</dt><dd>{humanSize(item.size)}</dd></div>
          <div><dt>源文件</dt><dd>{item.file}</dd></div>
        </dl>

        <div style="display:flex;flex-direction:column;gap:var(--s-2);margin-top:var(--s-5)">
          <a class="btn btn--primary" href={item.view} target="_blank" rel="noopener" download>下载大图（CDN 优化 WebP）↓</a>
          <a class="btn" href={item.full} target="_blank" rel="noopener" download>下载原始文件（GitHub · 约 {humanSize(item.size)}）↓</a>
          <a class="btn" href={`https://github.com/Nailong-Studio/wallpaper/blob/main/${item.src.replace(/^wallpapers\//, "")}`} target="_blank" rel="noopener">
            在 GitHub 查看源文件 ↗
          </a>
        </div>
      </div>
    </div>

    <nav class="section" aria-label="展厅内翻页" style="display:flex;gap:var(--s-3);justify-content:space-between;flex-wrap:wrap">
      {
        prev ? (
          <a class="btn" href={url(`/artwork/${prev.category}/${prev.slug}/`)} data-pager-prev>← {prev.title}</a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="btn" href={url(`/artwork/${next.category}/${next.slug}/`)} data-pager-next>{next.title} →</a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>

  {
    related.length > 0 && (
      <section class="section wrap" aria-labelledby="related-title">
        <h2 id="related-title" class="eyebrow" style="margin-bottom:var(--s-4)">
          同一展厅的其它作品
        </h2>
        <div class="masonry">
          {related.map((a) => (
            <ArtCard item={a} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
