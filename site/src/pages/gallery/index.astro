---
import BaseLayout from "../../layouts/BaseLayout.astro"
import GalleryView from "../../components/GalleryView.astro"
import { artworks } from "../../lib/artworks"
import { url } from "../../lib/url"

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: "奶龙艺术宇宙 · 全部作品",
  numberOfItems: artworks.length,
  image: artworks.slice(0, 24).map((a) => a.full),
}
---

<BaseLayout
  title="全部作品"
  description={`奶龙艺术宇宙的五个展厅共收录 ${artworks.length} 件作品：横幅长廊、古典殿堂、动态特展、掌中画廊与艺术新语。点击即可放大预览原图。`}
  jsonLd={itemListLd}
>
  <GalleryView active="all" items={artworks} />
  <div class="wrap" style="margin-top:var(--s-6)">
    <a class="btn" href={url("/")}>← 返回首页</a>
  </div>
</BaseLayout>
