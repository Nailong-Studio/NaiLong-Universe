---
import type { GetStaticPaths } from "astro"
import BaseLayout from "../../layouts/BaseLayout.astro"
import GalleryView from "../../components/GalleryView.astro"
import { categories } from "../../lib/artworks"
import { byCategory } from "../../lib/artworks"
import { url } from "../../lib/url"
import type { Category } from "../../lib/types"

export const getStaticPaths = (() =>
  categories.map((c) => ({
    params: { category: c.slug },
    props: { category: c.category as Category },
  }))) satisfies GetStaticPaths

const { category } = Astro.props as { category: Category }
const info = categories.find((c) => c.category === category)!
const items = byCategory(category)

const ld = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: `奶龙艺术宇宙 · ${info.name}`,
  description: info.description,
  numberOfItems: items.length,
  image: items.slice(0, 24).map((a) => a.full),
}
---

<BaseLayout
  title={`${info.name} · ${info.en}`}
  description={`${info.description} 本展厅共 ${items.length} 件作品，点开即可放大预览原图。`}
  image={items[0] ? items[0].thumb : undefined}
  jsonLd={ld}
>
  <GalleryView active={category} items={items} />

  <div class="wrap" style="margin-top:var(--s-7)">
    <h2 class="eyebrow" style="margin-bottom:var(--s-3)">其他展厅</h2>
    <div style="display:flex;flex-wrap:wrap;gap:var(--s-2)">
      {
        categories
          .filter((c) => c.category !== category)
          .map((c) => (
            <a class="chip" href={url(`/gallery/${c.slug}/`)}>
              {c.name}（{c.count}）
            </a>
          ))
      }
    </div>
  </div>
</BaseLayout>
