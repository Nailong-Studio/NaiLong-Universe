---
import BaseLayout from "../layouts/BaseLayout.astro"
import StoryView from "../components/StoryView.astro"
import { artworks } from "../lib/artworks"

// 按图片真实形状混搭选样：竖幅进「上下滚动」段，横幅进「横向长廊」段
const sorted = [...artworks].sort((a, b) => (a.id < b.id ? -1 : 1))
const portraitPicks = sorted.filter((a) => a.h >= a.w).slice(0, 14)
const landscapePicks = sorted.filter((a) => a.w > a.h).slice(0, 10)
const pick = [...portraitPicks, ...landscapePicks]

const ld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "奶龙艺术宇宙 · 沉浸式漫游",
  description: `逐屏浏览 ${pick.length} 件精选作品：每屏一幅、附创作手记，滚动即换屏。`,
  isPartOf: { "@type": "WebSite", name: "奶龙艺术宇宙" },
}
---

<BaseLayout
  title="沉浸式漫游 · 奶龙艺术宇宙"
  description={`逐屏浏览精选作品：每屏一幅、附特别字体的创作手记，滚动换屏。`}
  jsonLd={ld}
>
  <StoryView items={pick} />
</BaseLayout>
