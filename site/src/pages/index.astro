---
import BaseLayout from "../layouts/BaseLayout.astro"
import HeroCanvas from "../components/HeroCanvas.astro"
import ThemeRail from "../components/ThemeRail.astro"
import MasonryGrid from "../components/MasonryGrid.astro"
import { artworks, categories, featured } from "../lib/artworks"
import { url } from "../lib/url"

const heroVideo = url("/video/nailong-hero.mp4")
const picks = featured(9)

const ld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "奶龙艺术宇宙",
  description: `奶龙主题艺术画廊：五个展厅、${artworks.length} 件作品。`,
  isPartOf: { "@type": "WebSite", name: "奶龙艺术宇宙" },
}
---

<BaseLayout
  title="奶龙艺术宇宙 · 画廊"
  description={`${artworks.length} 件奶龙主题作品，分为横幅长廊、古典殿堂、动态特展、掌中画廊、艺术新语五个展厅。可放大查看原图、按展厅筛选、一键进入专注模式。`}
  jsonLd={ld}
>
  <section class="hero">
    <video
      class="hero__video decor"
      src={heroVideo}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      tabindex="-1"
    ></video>
    <HeroCanvas />
    <div class="wrap hero__inner">
      <p class="eyebrow" data-hero-in style="--hero-delay:80ms">NAILONG ART UNIVERSE · EST. 2026</p>
      <h1 class="hero__title">
        把奶龙，<em>放进</em><br />艺术史的每一格
      </h1>
      <p class="hero__lede" data-hero-in style="--hero-delay:220ms">
        {artworks.length} 件作品，五个展厅。从古典名画的戏仿，到动态壁纸的定格瞬间——
        每一张都以原图分辨率呈现，可放大、可下载、可带走。
      </p>
      <div class="hero__cta" data-hero-in style="--hero-delay:340ms">
        <a class="btn btn--primary" href={url("/gallery/")}>进入画廊 →</a>
        <a class="btn" href={url("/about/")}>这是什么项目</a>
      </div>
      <div class="hero__stats" data-hero-in style="--hero-delay:460ms">
        <span><b data-countup>{artworks.length}</b>件作品</span>
        <span><b data-countup>{categories.length}</b>个展厅</span>
        <span><b data-countup>100%</b>原图直出</span>
        <span><b data-countup>0</b>追踪脚本</span>
    </div>

    <div class="hero__spectrum" aria-hidden="true" data-hero-in style="--hero-delay:580ms">
      <i style="--t:#FFD54F"></i><i style="--t:#E8C48A"></i><i style="--t:#7FD1B9"></i><i style="--t:#9BB7FF"></i><i style="--t:#FF9FB2"></i>
    </div>
  </div>
  <span class="scroll-hint" aria-hidden="true">SCROLL ↓</span>
  </section>

  <ThemeRail />

  <section class="section" aria-labelledby="picks-title">
    <div class="wrap">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:var(--s-4);flex-wrap:wrap;margin-bottom:var(--s-5)">
        <div>
          <p class="eyebrow" data-reveal>SELECTED</p>
          <h2 id="picks-title" style="font-size:var(--fs-2xl);margin-top:var(--s-2)" data-reveal>编辑精选</h2>
        </div>
        <a class="btn" href={url("/gallery/")} data-reveal>查看全部 {artworks.length} 件 →</a>
      </div>
      <MasonryGrid items={picks} />
    </div>
  </section>

  <section class="section" aria-labelledby="about-strip">
    <div class="wrap wrap-narrow">
      <p class="eyebrow" data-reveal>WHY IT FEELS DIFFERENT</p>
      <h2 id="about-strip" style="font-size:var(--fs-2xl);margin:var(--s-2) 0 var(--s-4)" data-reveal>
        一个「不打扰人」的展厅
      </h2>
      <div style="display:grid;gap:var(--s-5)" data-reveal>
        <p style="color:var(--c-text-dim)">
          我们没有做加载动画、没有做全屏转场、没有用一张图 300KB 的第三方字体。
          页面默认零 JS 渲染，只有你真的要点开、要筛选、要切换模式时才加载交互逻辑。
        </p>
        <p style="color:var(--c-text-dim)">
          原图不在本仓库里，而是直接引用壁纸库的原始文件，经 CDN 按你的屏幕宽度实时转码。
          所以你能看到 1536×2752 的完整细节，而不会让任何人先下载 280MB。
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:var(--s-3)">
          <a class="btn" href={url("/about/")}>技术细节 →</a>
          <a class="btn" href="https://github.com/Nailong-Studio" rel="noopener">GitHub 组织 ↗</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
