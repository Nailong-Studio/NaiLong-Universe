---
/**
 * Lightbox —— 原生 <dialog>，零依赖。
 * 行为由 src/scripts/site.ts 接管；无 JS 时卡片链接直接跳转详情页（渐进增强）。
 */
---

<dialog class="lightbox" data-lightbox aria-label="作品大图预览">
  <div class="lightbox__stage">
    <img class="lightbox__img" alt="" />
  </div>

  <button class="lightbox__nav lightbox__nav--prev" type="button" data-lb-prev aria-label="上一件作品">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M15 5l-7 7 7 7"></path>
    </svg>
  </button>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-lb-next aria-label="下一件作品">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M9 5l7 7-7 7"></path>
    </svg>
  </button>

  <button class="icon-btn lightbox__close" type="button" data-lb-close aria-label="关闭预览">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>

  <div class="lightbox__bar">
    <span data-lb-caption></span>
    <span class="eyebrow" data-lb-counter></span>
    <a class="btn" data-lb-open href="#" rel="noopener">查看详情</a>
  </div>
</dialog>
