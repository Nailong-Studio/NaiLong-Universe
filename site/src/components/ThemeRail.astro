---
import { categories } from "../lib/artworks"
import { url } from "../lib/url"
import { byCategory } from "../lib/artworks"

const cover = (slug: string) => {
  const first = categories.find((c) => c.slug === slug)
  if (!first) return undefined
  return byCategory(first.category)[0]
}
---

<section class="section" aria-labelledby="rail-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>FIVE HALLS</p>
    <h2 id="rail-title" style="font-size:var(--fs-2xl);margin:var(--s-2) 0 var(--s-6)" data-reveal>
      五个展厅，五种看奶龙的方式
    </h2>

    <div class="rail">
      {
        categories.map((c, i) => {
          const item = cover(c.slug)
          return (
            <a
              class="rail__card"
              href={url(`/gallery/${c.slug}/`)}
              style={`--tint:${c.accent}`}
              data-reveal
              data-reveal-delay={String(i * 60)}
            >
              <span class="rail__count">{c.count} 件</span>
              <span class="rail__name">{c.name}</span>
              <span class="rail__en">{c.en}</span>
              <span class="rail__slogan">{c.slogan}</span>
              {item && (
                <span
                  class="card"
                  style={`--tint:${item.dominant};--lqip:url("${item.lqip}");aspect-ratio:${item.w}/${item.h};margin-top:var(--s-3)`}
                  aria-hidden="true"
                >
                  <img src={url(item.thumb)} alt="" width="400" height={Math.round((400 * item.h) / item.w)} loading="lazy" decoding="async" data-fade />
                </span>
              )}
            </a>
          )
        })
      }
    </div>
  </div>
</section>
