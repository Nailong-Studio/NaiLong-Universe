---
/**
 * HeroCanvas —— 首屏装饰性 canvas（零依赖 2D）
 * 漂浮柔光团 + 缓慢星尘，命中「奶黄 / 绿眼」品牌色，叠加更发光。
 * 无障碍：aria-hidden；prefers-reduced-motion / 专注模式下一律不渲染。
 */
---

<canvas class="hero-canvas decor" data-hero-canvas aria-hidden="true"></canvas>

<script>
  type Blob = { x: number; y: number; r: number; vx: number; vy: number; c: string }
  type Star = { x: number; y: number; s: number; ph: number }

  function boot() {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-canvas]")
    if (!canvas) return
    const ctx = canvas.getContext("2d", { alpha: true })
    if (!ctx) return
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return
    if (document.documentElement.dataset.focus === "on") return

    const palette = ["255,213,79", "102,187,106", "249,168,37", "254,249,237"]
    let w = 0
    let h = 0
    let dpr = 1
    let blobs: Blob[] = []
    let stars: Star[] = []
    let raf = 0
    let paused = false
    let t = 0

    const resize = () => {
      dpr = Math.min(devicePixelRatio || 1, 1.6)
      const rect = canvas.getBoundingClientRect()
      w = Math.max(1, rect.width)
      h = Math.max(1, rect.height)
      canvas.width = Math.floor(w * dpr)
      canvas.height = Math.floor(h * dpr)
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      const n = w < 700 ? 7 : 13
      blobs = Array.from({ length: n }, (_, i) => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: 90 + Math.random() * 240,
        vx: (Math.random() - 0.5) * 0.14,
        vy: (Math.random() - 0.5) * 0.14,
        c: palette[i % palette.length],
      }))
      const sc = Math.round((w * h) / 26000)
      stars = Array.from({ length: Math.min(sc, 90) }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        s: 0.6 + Math.random() * 1.6,
        ph: Math.random() * Math.PI * 2,
      }))
    }

    const frame = () => {
      raf = 0
      if (paused) return
      t += 0.016
      ctx.clearRect(0, 0, w, h)
      ctx.globalCompositeOperation = "lighter"
      for (const b of blobs) {
        b.x += b.vx
        b.y += b.vy
        if (b.x < -b.r) b.x = w + b.r
        if (b.x > w + b.r) b.x = -b.r
        if (b.y < -b.r) b.y = h + b.r
        if (b.y > h + b.r) b.y = -b.r
        const g = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, b.r)
        g.addColorStop(0, `rgba(${b.c},0.16)`)
        g.addColorStop(0.6, `rgba(${b.c},0.05)`)
        g.addColorStop(1, `rgba(${b.c},0)`)
        ctx.fillStyle = g
        ctx.beginPath()
        ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2)
        ctx.fill()
      }
      for (const st of stars) {
        const a = 0.25 + 0.55 * (0.5 + 0.5 * Math.sin(t * 1.4 + st.ph))
        ctx.fillStyle = `rgba(255,247,224,${a})`
        ctx.beginPath()
        ctx.arc(st.x, st.y, st.s, 0, Math.PI * 2)
        ctx.fill()
      }
      ctx.globalCompositeOperation = "source-over"
      raf = requestAnimationFrame(frame)
    }

    const start = () => {
      if (!raf && !paused) raf = requestAnimationFrame(frame)
    }
    const stop = () => {
      if (raf) cancelAnimationFrame(raf)
      raf = 0
    }

    resize()
    start()
    addEventListener("resize", () => {
      resize()
      start()
    })
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()))
    addEventListener("nl:pause-decor", () => {
      paused = true
      stop()
      ctx.clearRect(0, 0, w, h)
    })
    addEventListener("nl:resume-decor", () => {
      paused = false
      start()
    })
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot)
  else boot()
</script>
