---
import { categories, countOf } from "../lib/artworks"
import { url } from "../lib/url"
import type { Category } from "../lib/types"

export interface Props {
  active: Category | "all"
}

const { active } = Astro.props

const chips: { key: Category | "all"; label: string; href: string }[] = [
  { key: "all", label: "全部", href: url("/gallery/") },
  ...categories.map((c) => ({ key: c.category as Category, label: c.name, href: url(`/gallery/${c.slug}/`) })),
]
---

<nav class="filterbar" data-filterbar aria-label="按展厅筛选作品">
  {
    chips.map((chip) => (
      <a
        class="chip"
        href={chip.href}
        data-chip={chip.key}
        aria-current={chip.key === active ? "page" : undefined}
      >
        {chip.label}
      </a>
    ))
  }
  <span class="filterbar__count" data-filter-count aria-live="polite">{countOf(active)} 件</span>
</nav>
