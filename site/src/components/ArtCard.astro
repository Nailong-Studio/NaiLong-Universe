---
import type { Artwork } from "../lib/types"
import { url } from "../lib/url"
import { themeOf } from "../lib/artworks"

export interface Props {
  item: Artwork
  /** 首屏图片：不懒加载 + 高优先级 */
  eager?: boolean
  /** reveal 延迟（毫秒），用于错峰进场 */
  delay?: number
}

const { item, eager = false, delay = 0 } = Astro.props
const theme = themeOf(item.category)
const href = url(`/artwork/${item.category}/${item.slug}/`)

// 跨页共享元素名：画廊卡片封面 ↔ 详情页主图（CSS ident，净化特殊字符）
const vtName = `art-${item.category}-${item.slug.replace(/[^\p{L}\p{N}_-]/gu, "-")}`

// 缩略图固定 400px 宽，按原始比例换算显示尺寸，防止 CLS
const TW = 400
const TH = Math.round((400 * item.h) / item.w)
const displayTitle = item.variant ? `${item.title} · ${item.variant}` : item.title
---

<a
  class="card"
  href={href}
  style={`--tint:${item.dominant};--lqip:url("${item.lqip}");aspect-ratio:${item.w}/${item.h}`}
  data-cat={item.category}
  data-lb
  data-lb-full={item.view}
  data-lb-srcset={item.fullSrcset}
  data-lb-title={displayTitle}
  data-lb-href={href}
  data-lb-w={item.w}
  data-lb-h={item.h}
  data-reveal
  data-reveal-delay={String(delay)}
  aria-label={`查看作品：${displayTitle}`}
>
  <img
    src={url(item.thumb)}
    alt={`${displayTitle}（${theme.name}）`}
    width={TW}
    height={TH}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : "auto"}
    data-fade
    transition:name={vtName}
  />
  <span class="card__badge">{theme.name}</span>
</a>
