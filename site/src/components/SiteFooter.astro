---
import { url } from "../lib/url"
import { categories, artworks } from "../lib/artworks"

const ORG = "https://github.com/Nailong-Studio"
const MAIN = `${ORG}/NaiLong-Universe`
const WALL = `${ORG}/wallpaper`

const family = [
  {
    href: MAIN,
    title: "NaiLong-Universe",
    desc: "主题宇宙主仓：palette.json 单一色源、macOS / Windows 桌面主题、终端配色。",
    tag: "主仓",
  },
  {
    href: WALL,
    title: "wallpaper",
    desc: `全部 ${artworks.length} 张原始壁纸的出处，本站只展示、不复制。`,
    tag: "壁纸库",
  },
  {
    href: `${MAIN}/tree/main/themes`,
    title: "桌面与终端主题",
    desc: "把奶龙的奶黄与绿眼装进系统 UI、终端和编辑器。",
    tag: "主题",
  },
  {
    href: `${ORG}/nailong-vscode-theme`,
    title: "VS Code 主题",
    desc: "奶黄 #FFD54F + 绿眼 #66BB6A 的编辑器配色方案。",
    tag: "编辑器",
  },
]
---

<footer class="site-footer">
  <div class="wrap">
    <h2 class="eyebrow" style="margin-bottom:var(--s-4)">奶龙主题宇宙 · 家族导航</h2>
    <div class="family">
      {
        family.map((f) => (
          <a href={f.href} rel="noopener">
            <strong>
              {f.title} <span aria-hidden="true">↗</span>
            </strong>
            <span>{f.desc}</span>
          </a>
        ))
      }
    </div>

    <nav aria-label="展厅索引" style="margin-bottom:var(--s-6);display:flex;flex-wrap:wrap;gap:var(--s-3)">
      <a href={url("/gallery/")}>全部作品</a>
      {
        categories.map((c) => (
          <a href={url(`/gallery/${c.slug}/`)}>
            {c.name}（{c.count}）
          </a>
        ))
      }
      <a href={url("/about/")}>关于本站</a>
    </nav>

    <div class="footer__bottom">
      <span>© {new Date().getFullYear()} Nailong-Studio · 非官方同人企划，仅供个人欣赏</span>
      <span>Astro 静态站点 · 图片经 CDN 按需转码 · 无追踪、无 Cookie</span>
    </div>
  </div>
</footer>
