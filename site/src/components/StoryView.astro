---
import type { Artwork } from "../lib/types"
import { url } from "../lib/url"
import { themeOf } from "../lib/artworks"

export interface Props {
  items: Artwork[]
}

const { items } = Astro.props
const heroVideo = url("/video/nailong-hero.mp4")

// 按图片真实形状分向：横幅（宽 > 高）进横向走廊左右滑动，竖幅/方形保持上下滚动
const portrait = items.filter((i) => i.h >= i.w)
const landscape = items.filter((i) => i.w > i.h)
---

<section class="story" data-story data-hero-video={heroVideo}>
  <video
    class="story__video decor"
    src={heroVideo}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
    tabindex="-1"
  ></video>

  <div class="story__panes">
    {
      portrait.map((item, i) => {
        const theme = themeOf(item.category)
        const displayTitle = item.variant ? `${item.title} · ${item.variant}` : item.title
        const vtName = `story-art-${item.category}-${item.slug.replace(/[^\p{L}\p{N}_-]/gu, "-")}`
        const parallax = (i % 3) - 1
        return (
          <section
            class="story__pane"
            data-pane
            style={`--pane-parallax:${parallax};--tint:${item.dominant}`}
            aria-label={`作品 ${i + 1}：${displayTitle}`}
          >
            <div class="story__pane-bg" aria-hidden="true"></div>
            <div class="story__media" data-story-media>
              <img
                src={item.view}
                srcset={item.fullSrcset}
                sizes="(min-width: 1000px) 52vw, 100vw"
                width={item.w}
                height={item.h}
                alt={`${displayTitle} —— ${theme.name}`}
                decoding="async"
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : "auto"}
                data-story-img
                data-fade
                transition:name={vtName}
              />
            </div>

            <div class="story__copy" data-story-copy>
              <p class="story__index eyebrow">{String(i + 1).padStart(2, "0")} / {String(items.length).padStart(2, "0")}</p>
              <p class="story__theme eyebrow">{theme.en} · {theme.name}</p>
              <h2 class="story__title">{displayTitle}</h2>
              <p class="story__story">{item.story}</p>
              <div class="story__tags" aria-hidden="true">
                {item.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              <a class="btn" href={url(`/artwork/${item.category}/${item.slug}/`)}>查看详情 →</a>
            </div>
          </section>
        )
      })
    }

    {
      landscape.length > 0 && (
        <section class="story__hall" data-hall aria-label="横向长廊 · 横幅作品" data-hall-count={landscape.length}>
          <div class="story__hall-head">
            <p class="eyebrow">HORIZONTAL WING · 横廊</p>
            <p class="story__hall-title">为横版而生</p>
            <p class="story__hall-sub">这些宽幅作品适合横向浏览 —— 左右滑动，一幅接一幅。</p>
          </div>

          <div class="story__hall-track" data-hall-track>
            {
              landscape.map((item, i) => {
                const theme = themeOf(item.category)
                const displayTitle = item.variant ? `${item.title} · ${item.variant}` : item.title
                const vtName = `story-art-${item.category}-${item.slug.replace(/[^\p{L}\p{N}_-]/gu, "-")}`
                return (
                  <figure class="story__slide" data-slide style={`--tint:${item.dominant}`} aria-label={`横幅作品 ${i + 1}：${displayTitle}`}>
                    <span class="story__slide-no" aria-hidden="true">{String(i + 1).padStart(2, "0")} / {String(landscape.length).padStart(2, "0")}</span>
                    <img
                      class="story__slide-img"
                      src={item.view}
                      srcset={item.fullSrcset}
                      sizes="(min-width: 1000px) 60vw, 100vw"
                      width={item.w}
                      height={item.h}
                      alt={`${displayTitle} —— ${theme.name}横幅`}
                      decoding="async"
                      loading="lazy"
                      data-fade
                      data-slide-img
                      transition:name={vtName}
                    />
                    <figcaption class="story__slide-cap" data-slide-cap>
                      <p class="story__theme eyebrow">{theme.en} · {theme.name}</p>
                      <h3 class="story__title">{displayTitle}</h3>
                      <p class="story__story">{item.story}</p>
                      <a class="btn" href={url(`/artwork/${item.category}/${item.slug}/`)}>查看详情 →</a>
                    </figcaption>
                  </figure>
                )
              })
            }
          </div>

          <p class="story__hall-hint" aria-hidden="true">← 左右滑动 →</p>
        </section>
      )
    }
  </div>

  <div class="story__progress" aria-hidden="true">
    <span data-story-progress></span>
  </div>

  <!-- 滚动即叙事：当前屏的固定号牌（SpaceX 式任务序号） -->
  <p class="story__stag" data-story-stag aria-hidden="true">
    <span data-story-stag-no></span>
    <span class="story__stag-name" data-story-stag-name></span>
  </p>

  <!-- 深空氛围：story 专属星尘粒子层 -->
  <canvas class="story__dust decor" data-story-dust aria-hidden="true"></canvas>

  <p class="story__hint scroll-hint" data-story-hint aria-hidden="true">SCROLL ↓ 逐屏漫游</p>
</section>

<style>
  /* Story 模式样式集中在 global.css */
</style>