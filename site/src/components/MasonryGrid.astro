---
import type { Artwork } from "../lib/types"
import ArtCard from "./ArtCard.astro"

export interface Props {
  items: Artwork[]
  /** 首批前 N 张使用 eager，提升 LCP */
  eagerCount?: number
}

const { items, eagerCount = 6 } = Astro.props
---

<div class="masonry" data-grid data-lb-scope>
  {
    items.map((item, i) => (
      <ArtCard item={item} eager={i < eagerCount} delay={(i % 12) * 40} />
    ))
  }
</div>
