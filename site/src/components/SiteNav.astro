---
import { url } from "../lib/url"
import { categories } from "../lib/artworks"

const here = Astro.url.pathname
const isActive = (href: string) => (href === url("/") ? here === url("/") : here.startsWith(href))

const nav = [
  { href: url("/"), label: "首页" },
  { href: url("/story/"), label: "漫游" },
  ...categories.map((c) => ({ href: url(`/gallery/${c.slug}/`), label: c.name })),
  { href: url("/gallery/"), label: "全部作品" },
  { href: url("/about/"), label: "关于" },
]
---

<header class="site-nav">
  <div class="wrap site-nav__inner">
    <a class="brand" href={url("/")} aria-label="奶龙艺术宇宙 首页">
      <span class="brand__dot" aria-hidden="true"></span>
      <span>奶龙艺术宇宙</span>
      <span class="brand__sub">NAILONG&nbsp;GALLERY</span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      {
        nav.slice(1).map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-actions">
      <button class="icon-btn" type="button" data-music aria-pressed="false" title="播放/停止背景音乐" aria-label="播放背景音乐">
        <svg class="music-ico" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M9 18V6l10-2v12"></path>
          <circle cx="6.5" cy="18" r="2.5"></circle>
          <circle cx="16.5" cy="16" r="2.5"></circle>
        </svg>
        <svg class="music-ico music-ico--off" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M9 18V6l10-2v12"></path>
          <path d="M4 4l16 16"></path>
        </svg>
      </button>
      <button class="icon-btn" type="button" data-toggle-focus aria-pressed="false" title="专注模式：隐藏装饰动效" aria-label="切换专注模式">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="3.2"></circle>
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2"></path>
        </svg>
      </button>
      <button class="icon-btn" type="button" data-toggle-theme aria-pressed="false" title="切换深浅色" aria-label="切换深浅色">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 13a8.5 8.5 0 1 1-10-10 7 7 0 0 0 10 10Z"></path>
        </svg>
      </button>
      <button class="icon-btn nav-toggle" type="button" data-drawer-toggle aria-expanded="false" aria-controls="mobile-drawer" aria-label="打开菜单">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="mobile-drawer" data-drawer data-open="false" inert aria-label="移动端导航">
  <div class="wrap">
    <p class="eyebrow">NAILONG GALLERY</p>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
      <li><a href="https://github.com/Nailong-Studio" rel="noopener">GitHub 组织 ↗</a></li>
    </ul>
  </div>
</div>
