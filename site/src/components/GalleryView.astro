---
import FilterBar from "./FilterBar.astro"
import MasonryGrid from "./MasonryGrid.astro"
import type { Artwork, Category } from "../lib/types"
import { categories } from "../lib/artworks"

export interface Props {
  active: Category | "all"
  items: Artwork[]
}

const { active, items } = Astro.props
const theme = categories.find((c) => c.category === active)
---

<section class="wrap" style="padding-top:var(--s-7)">
  <header style="max-width:62ch;margin-bottom:var(--s-5)">
    <p class="eyebrow" data-reveal>{theme ? theme.en : "ALL WORKS"}</p>
    <h1 style="font-size:var(--fs-3xl);margin:var(--s-2) 0 var(--s-3)" data-reveal>
      {theme ? theme.name : "全部作品"}
    </h1>
    <p style="color:var(--c-text-dim)" data-reveal>
      {theme ? theme.description : "五个展厅的全部藏品。点击任意作品可放大预览原图，或进入详情页查看完整信息。"}
    </p>
  </header>

  <FilterBar active={active} />

  <MasonryGrid items={items} eagerCount={4} />

  <noscript>
    <p style="margin-top:var(--s-6);color:var(--c-text-mute)">
      当前浏览器未启用 JavaScript：筛选请使用上方链接跳转，点击作品将直接进入详情页。
    </p>
  </noscript>
</section>
